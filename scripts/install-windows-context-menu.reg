Windows Registry Editor Version 5.00

; AeroDiff Windows Explorer Context Menu Registration
; Enables right-clicking any file or folder to "Compare with AeroDiff"

; Context menu for all files
[HKEY_CLASSES_ROOT\*\shell\AeroDiff]
@="Compare with AeroDiff"
"Icon"="\"%LOCALAPPDATA%\\AeroDiff\\AeroDiff.exe\""

[HKEY_CLASSES_ROOT\*\shell\AeroDiff\command]
@="\"%LOCALAPPDATA%\\AeroDiff\\AeroDiff.exe\" \"%1\""

; Context menu for directories (folders)
[HKEY_CLASSES_ROOT\Directory\shell\AeroDiff]
@="Compare with AeroDiff"
"Icon"="\"%LOCALAPPDATA%\\AeroDiff\\AeroDiff.exe\""

[HKEY_CLASSES_ROOT\Directory\shell\AeroDiff\command]
@="\"%LOCALAPPDATA%\\AeroDiff\\AeroDiff.exe\" \"%1\""
